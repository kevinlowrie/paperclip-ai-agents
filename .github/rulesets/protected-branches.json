{
  "conditions": {
    "ref_name": {
      "exclude": [],
      "include": [
        "~DEFAULT_BRANCH",
        "refs/heads/main",
        "refs/heads/master",
        "refs/heads/testing",
        "refs/heads/freeze",
        "refs/heads/release-candidate",
        "refs/heads/release",
        "refs/heads/prod"
      ]
    }
  },
  "enforcement": "active",
  "name": "homelab-protected-release-branches",
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "parameters": {
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_approving_review_count": 1,
        "required_review_thread_resolution": true
      },
      "type": "pull_request"
    }
  ],
  "target": "branch"
}
